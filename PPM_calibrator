# RTL-SDR carrier finder / PPM calibrator.

# Usage: PPM_calibrator [-h] [--scan] [--range RANGE RANGE RANGE] [-i INTERVAL] [-g GAIN] [--rate RATE] [-n SAMPLES] [freq]

# Positional arguments:
#  freq                  Frequency to lock onto, in MHz (or Hz if > 1e6)

# optional arguments:
#  -h, --help            show this help message and exit
#  --scan, -s            Sweep-scan mode instead of single frequency
#  --range ..., -r ...   START_FREQ STOP_FREQ STEP - Use with --scan mode
#                        If STEP omitted, uses (default uses CONFIG_STEP_MHZ)
#  -i INTERVAL, --interval INTERVAL
#                        Seconds between measurements (default uses CONFIG_INTERVAL_SEC)
#  -g GAIN, --gain GAIN  SDR Gain(default uses CONFIG_GAIN_DB)
#  --rate RATE, -R RATE  Sample rate in MHz (default uses CONFIG_SAMPLE_RATE_MHZ)
#  -n SAMPLES, --samples SAMPLES
#                        Number of samples (default use CONFIG_NUM_SAMPLES)

# Examples: ./PPM_calibrator 401.5 monitor 401.5 MHz 
#           ./PPM_calibrator 401.5 -i 2 same, update every 2 s
#           ./PPM_calibrator --scan sweep using CONFIG_ values 
#           ./PPM_calibrator --scan --range 400 403 0.5 sweep using custom range



import numpy as np
from rtlsdr import RtlSdr
import time
import sys
import select
import termios
import tty
import argparse

# ==========================================
# CONFIGURATION SECTION
# ==========================================
CONFIG_START_FREQ_MHZ = 88.0
CONFIG_END_FREQ_MHZ   = 108.0
CONFIG_STEP_MHZ       = 0.5
CONFIG_INTERVAL_SEC   = 5
CONFIG_SAMPLE_RATE_MHZ= 1.25
CONFIG_GAIN_DB        = 50
CONFIG_NUM_SAMPLES    = 65536
# ==========================================


class CarrierFinder:
    def __init__(self, center_freq=100e6, sample_rate=2.4e6, gain=50):
        self.sdr = RtlSdr()
        self.sdr.sample_rate = sample_rate
        self.sdr.center_freq = center_freq
        self.sdr.gain = gain
        self.ppm = 0
        self._old_settings = None

    def _setup_terminal(self):
        self._old_settings = termios.tcgetattr(sys.stdin)
        tty.setcbreak(sys.stdin.fileno())

    def _restore_terminal(self):
        if self._old_settings:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self._old_settings)

    def _get_key(self):
        if select.select([sys.stdin], [], [], 0)[0]:
            return sys.stdin.read(1)
        return None

    def _handle_ppm_input(self):
        key = self._get_key()
        if not key:
            return
        if key == '0':
            self.ppm = 0
        else:
            delta = {'+': 1, '=': 1, ']': 10, '.': 10,
                     '-': -1, '_': -1, '[': -10, ',': -10}.get(key)
            if delta is None:
                if key in ('q', 'Q'):
                    raise KeyboardInterrupt
                return
            self.ppm += delta
        self.sdr.freq_correction = self.ppm

    def measure_at(self, nominal_hz, num_samples):
        """Measure power and precise frequency at a specific nominal frequency."""
        # Use actual hardware sample rate for accurate bin calculation
        actual_sample_rate = self.sdr.get_sample_rate()
        
        ppm_factor = 1 + (self.ppm * 1e-6)
        tuned_hz = nominal_hz * ppm_factor
        self.sdr.center_freq = tuned_hz
        samples = self.sdr.read_samples(num_samples)
        power = np.mean(np.abs(samples) ** 2)
        
        x = samples - np.mean(samples)
        fft_data = np.fft.fftshift(np.fft.fft(x))
        mag = np.abs(fft_data)
        n = len(samples)
        peak_idx = int(np.argmax(mag))
        
        # CRITICAL FIX: Use actual hardware sample rate instead of requested rate
        bin_hz = actual_sample_rate / n
        offset_hz = (peak_idx - n // 2) * bin_hz
        precise_freq = tuned_hz + offset_hz
        return power, precise_freq, actual_sample_rate

    def scan(self, start_freq, end_freq, step, num_samples):
        frequencies = np.arange(start_freq, end_freq, step)
        peak_freq = None
        peak_power = -np.inf
        print(f"Scanning {start_freq/1e6:.1f} MHz to {end_freq/1e6:.1f} MHz...")
        print(f"Step size: {step/1e6:.3f} MHz | PPM: {self.ppm}\n")
        for i, freq in enumerate(frequencies):
            self._handle_ppm_input()
            ppm_factor = 1 + (self.ppm * 1e-6)
            corrected_freq = freq * ppm_factor
            self.sdr.center_freq = corrected_freq
            samples = self.sdr.read_samples(num_samples)
            power = np.mean(np.abs(samples)**2)
            if power > peak_power:
                peak_power = power
                peak_freq = freq
            progress = (i + 1) / len(frequencies) * 100
            sys.stdout.write(f"\rProgress: {progress:.1f}%")
            sys.stdout.flush()
        print("\n")
        return peak_freq, peak_power

    def continuous_monitor(self, nominal_hz, interval, num_samples):
        self._setup_terminal()
        actual_rate = self.sdr.get_sample_rate()
        print(f"Monitoring single frequency: {nominal_hz/1e6:.6f} MHz")
        print(f"Actual Sample Rate: {actual_rate/1e6:.12f} MHz | Interval: {interval}s | Samples: {num_samples}")
        print("Keys: +/- = PPM 1   ]/. = PPM 10   [/ , = PPM -10   0 = reset")
        print("Adjust PPM until FREQUENCY matches expected station freq")
        print("Press Q to QUIT\n")
        try:
            while True:
                power, precise_freq, actual_rate = self.measure_at(nominal_hz, num_samples)
                timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
                power_db = 10 * np.log10(power) if power > 0 else -999
                # Use the rate returned by measure_at (which calls get_sample_rate() internally)
                print(f"[{timestamp}] FREQUENCY: {precise_freq/1e6:.6f} MHz | "
                      f"Power: {power_db:.2f} dB | PPM: {self.ppm}")
                end_time = time.time() + interval
                while time.time() < end_time:
                    self._handle_ppm_input()
                    time.sleep(0.05)
        except KeyboardInterrupt:
            print("\n\nStopped by user.")
        finally:
            self._restore_terminal()

    def continuous_scan(self, start_freq, end_freq, step, interval, num_samples):
        self._setup_terminal()
        actual_rate = self.sdr.get_sample_rate()
        print(f"Continuous scan: {start_freq/1e6:.1f} - {end_freq/1e6:.1f} MHz")
        print(f"Actual Sample Rate: {actual_rate/1e6:.12f} MHz | Step: {step/1e6:.3f} MHz | Interval: {interval}s")
        print("Keys: +/- PPM adjustment")
        print("Adjust PPM until FREQUENCY matches expected station freq")
        print("Press Q to QUIT\n")
        try:
            while True:
                peak_freq, peak_power = self.scan(start_freq, end_freq, step, num_samples)
                if peak_freq:
                    power, precise_freq, _ = self.measure_at(peak_freq, num_samples)
                    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
                    power_db = 10 * np.log10(power) if power > 0 else -999
                    print(f"[{timestamp}] FREQUENCY: {precise_freq/1e6:.6f} MHz | "
                          f"Power: {power_db:.2f} dB | PPM: {self.ppm}")
                else:
                    print(f"[{time.strftime('%H:%M:%S')}] No carrier | PPM: {self.ppm}")
                end_time = time.time() + interval
                while time.time() < end_time:
                    self._handle_ppm_input()
                    time.sleep(0.05)
        except KeyboardInterrupt:
            print("\n\nStopped by user.")
        finally:
            self._restore_terminal()

    def close(self):
        self.sdr.close()


def parse_args():
    p = argparse.ArgumentParser(
        description="RTL-SDR carrier finder / PPM calibrator.",
        epilog="Examples:\n"
               "  ./PPM_calibrator 401.5              monitor 401.5 MHz\n"
               "  ./PPM_calibrator 401.5 -i 2         same, update every 2 s\n"
               "  ./PPM_calibrator --scan             sweep using CONFIG_ values\n"
               "  ./PPM_calibrator --scan -r 400 403 0.5 sweep custom (step provided)\n"
               "  ./PPM_calibrator --scan -r 400 403   sweep custom (step defaults)\n",
        formatter_class=argparse.RawTextHelpFormatter)
    
    p.add_argument("freq", nargs="?", type=float,
                   help="Frequency to lock onto, in MHz (or Hz if > 1e6)")
    p.add_argument("--scan", "-s", action="store_true",
                   help="Sweep-scan mode instead of single frequency")
    p.add_argument("--range", "-r", nargs=argparse.REMAINDER, type=float,
                   help=f"START_FREQ STOP_FREQ STEP - Use with --scan mode\nIf STEP omitted, uses (default {CONFIG_STEP_MHZ})")
    p.add_argument("-i", "--interval", type=float, default=CONFIG_INTERVAL_SEC,
                   help=f"Seconds between measurements (default {CONFIG_INTERVAL_SEC})")
    p.add_argument("-g", "--gain", type=float, default=CONFIG_GAIN_DB,
                   help=f"SDR Gain(default {CONFIG_GAIN_DB})")
    p.add_argument("--rate", "-R", type=float, default=CONFIG_SAMPLE_RATE_MHZ,
                   help=f"Sample rate in MHz (default {CONFIG_SAMPLE_RATE_MHZ})")
    p.add_argument("-n", "--samples", type=int, default=CONFIG_NUM_SAMPLES,
                   help=f"Number of samples (default {CONFIG_NUM_SAMPLES})")
    args = p.parse_args()

    start_freq = end_freq = step = None
    first_tune = None
    mode = None

    if args.scan:
        mode = "scan"
        if args.range:
            if len(args.range) < 2:
                p.error("--scan -r requires at least START and END frequencies.")
            start_freq = args.range[0] * 1e6
            end_freq = args.range[1] * 1e6
            if len(args.range) >= 3:
                step = args.range[2] * 1e6
            else:
                step = CONFIG_STEP_MHZ * 1e6
        else:
            start_freq = CONFIG_START_FREQ_MHZ * 1e6
            end_freq = CONFIG_END_FREQ_MHZ * 1e6
            step = CONFIG_STEP_MHZ * 1e6
        first_tune = start_freq
    else:
        mode = "monitor"
        if args.freq is None:
            p.error("Use PPM_calibrator -h for detailed help")
        first_tune = args.freq if args.freq > 1e6 else args.freq * 1e6

    return args, mode, start_freq, end_freq, step, first_tune


if __name__ == "__main__":
    args, mode, start_freq, end_freq, step, first_tune = parse_args()
    sample_rate = args.rate * 1e6

    try:
        finder = CarrierFinder(center_freq=first_tune, sample_rate=sample_rate, gain=args.gain)
    except Exception as e:
        error_msg = str(e)
        if "Resource busy" in error_msg or "LIBUSB_ERROR_BUSY" in error_msg:
            print("Error: The SDR device is busy. Please close other applications using it and try again.")
        else:
            print(f"Unexpected error opening SDR: {e}")
            raise
        sys.exit(1)

    try:
        if mode == "scan":
            finder.continuous_scan(start_freq, end_freq, step, args.interval, args.samples)
        else:
            finder.continuous_monitor(first_tune, args.interval, args.samples)
    except KeyboardInterrupt:
        print("\nStopped by user.")
    finally:
        finder.close()
