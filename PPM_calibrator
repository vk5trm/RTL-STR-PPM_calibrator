import numpy as np
import rtlsdr.rtlsdr as _rtlsdr_mod
_sync_names = ['RtlSdr', 'RtlSdrSync', 'RtlSdrDevice']
RtlSdr = None
for _name in _sync_names:
    _cls = getattr(_rtlsdr_mod, _name, None)
    if _cls and not _cls.__name__.endswith('Aio'):
        RtlSdr = _cls
        break

if RtlSdr is None:
    raise ImportError(
        "Could not find synchronous RtlSdr class. "
        "Update pyrtlsdr: pip3 install --upgrade pyrtlsdr"
    )
import time
import sys
import select
import termios
import tty
import argparse

class CarrierFinder:
    def __init__(self, center_freq=100e6, sample_rate=2.4e6, gain=50):
        self.sdr = RtlSdr()
        self.sdr.sample_rate = sample_rate
        self.sdr.center_freq = center_freq
        
        if str(gain).lower() == "auto" or gain is None:
            self.sdr.gain = "auto"
            self.is_agc = True
        else:
            try:
                self.sdr.gain = float(gain)
                self.is_agc = False
            except (ValueError, TypeError):
                print(f"Warning: Invalid gain '{gain}'. Falling back to AGC.")
                self.sdr.gain = "auto"
                self.is_agc = True
        
        self.ppm = 0
        self._old_settings = None

    def _setup_terminal(self):
        self._old_settings = termios.tcgetattr(sys.stdin)
        tty.setcbreak(sys.stdin.fileno())

    def _restore_terminal(self):
        if self._old_settings:
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self._old_settings)

    def _get_key(self):
        if select.select([sys.stdin], [], [], 0)[0]:
            return sys.stdin.read(1)
        return None

    def _handle_ppm_input(self):
        key = self._get_key()
        if not key:
            return
        if key == '0':
            self.ppm = 0
        else:
            delta = {'+': 1, '=': 1, ']': 10, '.': 10,
                     '-': -1, '_': -1, '[': -10, ',': -10}.get(key)
            if delta is None:
                if key in ('q', 'Q'):
                    raise KeyboardInterrupt
                return
            self.ppm += delta
        self.sdr.freq_correction = self.ppm

    def measure_at(self, nominal_hz, num_samples):
        """Measure power and precise frequency at a specific nominal frequency."""
        actual_sample_rate = self.sdr.get_sample_rate()
        
        ppm_factor = 1 + (self.ppm * 1e-6)
        tuned_hz = nominal_hz * ppm_factor
        self.sdr.center_freq = tuned_hz
        samples = self.sdr.read_samples(num_samples)
        power = np.mean(np.abs(samples) ** 2)
        x = samples - np.mean(samples)
        fft_data = np.fft.fftshift(np.fft.fft(x))
        mag = np.abs(fft_data)
        n = len(samples)
        peak_idx = int(np.argmax(mag))
        bin_hz = actual_sample_rate / n
        offset_hz = (peak_idx - n // 2) * bin_hz
        precise_freq = tuned_hz + offset_hz
        return power, precise_freq, actual_sample_rate

    def scan(self, start_freq, end_freq, step, num_samples):
        frequencies = np.arange(start_freq, end_freq, step)
        peak_freq = None
        peak_power = -np.inf
        print(f"Scanning {start_freq/1e6:.1f} MHz to {end_freq/1e6:.1f} MHz...")
        print(f"Step size: {step/1e6:.3f} MHz | PPM: {self.ppm}\n")
        for i, freq in enumerate(frequencies):
            self._handle_ppm_input()
            ppm_factor = 1 + (self.ppm * 1e-6)
            corrected_freq = freq * ppm_factor
            self.sdr.center_freq = corrected_freq
            samples = self.sdr.read_samples(num_samples)
            power = np.mean(np.abs(samples)**2)
            if power > peak_power:
                peak_power = power
                peak_freq = freq
            progress = (i + 1) / len(frequencies) * 100
            sys.stdout.write(f"\rProgress: {progress:.1f}%")
            sys.stdout.flush()
        print("\n")
        return peak_freq, peak_power

    def continuous_monitor(self, nominal_hz, interval, num_samples):
        self._setup_terminal()
        actual_rate = self.sdr.get_sample_rate()
        gain_display = "AGC" if self.is_agc else f"{self.sdr.gain:.1f} dB"
        print(f"Monitoring single frequency: {nominal_hz/1e6:.6f} MHz")
        print(f"Actual Sample Rate: {actual_rate/1e6:.12f} MHz | Samples: {num_samples} | Gain: {gain_display}")
        print("Keys: +/- = PPM 1   ]/. = PPM 10   [/ , = PPM -10   0 = reset")
        print("Adjust PPM until FREQUENCY matches expected station freq")
        print("Press Q to QUIT\n")
        try:
            while True:
                power, precise_freq, actual_rate = self.measure_at(nominal_hz, num_samples)
                timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
                power_db = 10 * np.log10(power) if power > 0 else -999
                print(f"[{timestamp}] FREQUENCY: {precise_freq/1e6:.6f} MHz | "
                      f"Power: {power_db:.2f} dB | PPM: {self.ppm}")
                end_time = time.time() + interval
                while time.time() < end_time:
                    self._handle_ppm_input()
                    time.sleep(0.05)
        except KeyboardInterrupt:
            print("\n\nStopped by user.")
        finally:
            self._restore_terminal()

    def continuous_scan(self, start_freq, end_freq, step, interval, num_samples):
        self._setup_terminal()
        actual_rate = self.sdr.get_sample_rate()
        gain_display = "AGC" if self.is_agc else f"{self.sdr.gain:.1f} dB"
        print(f"Continuous scan: {start_freq/1e6:.1f} - {end_freq/1e6:.1f} MHz")
        print(f"Actual Sample Rate: {actual_rate/1e6:.12f} MHz | Step: {step/1e6:.3f} MHz | Gain: {gain_display}")
        print("Keys: +/- PPM adjustment")
        print("Adjust PPM until FREQUENCY matches expected station freq")
        print("Press Q to QUIT\n")
        try:
            while True:
                peak_freq, peak_power = self.scan(start_freq, end_freq, step, num_samples)
                if peak_freq:
                    power, precise_freq, _ = self.measure_at(peak_freq, num_samples)
                    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
                    power_db = 10 * np.log10(power) if power > 0 else -999
                    print(f"[{timestamp}] FREQUENCY: {precise_freq/1e6:.6f} MHz | "
                          f"Power: {power_db:.2f} dB | PPM: {self.ppm}")
                else:
                    print(f"[{time.strftime('%H:%M:%S')}] No carrier | PPM: {self.ppm}")
                end_time = time.time() + interval
                while time.time() < end_time:
                    self._handle_ppm_input()
                    time.sleep(0.05)
        except KeyboardInterrupt:
            print("\n\nStopped by user.")
        finally:
            self._restore_terminal()

    def close(self):
        self.sdr.close()
def parse_args():
    p = argparse.ArgumentParser(
        description="RTL-SDR carrier finder / PPM calibrator.",
        epilog="While running in monitor or scan mode, you can adjust the PPM correction interactively:\n"
        " +  or  =   : increase PPM by 1\n"
        " -  or  _   : decrease PPM by 1\n"
        " ]  or  .   : increase PPM by 10\n"
        " [  or  ,   : decrease PPM by 10\n"
        " 0          : reset PPM to 0\n"
        " q          : quit\n",
        formatter_class=argparse.RawTextHelpFormatter)

    p.add_argument("freqs", nargs='*', type=float,
                   help="Frequency arguments.\n"
                        "Monitor mode: <freq>\n"
                        "Scan mode: <start> <stop> [step]")
    
    p.add_argument("-s", "--scan", action="store_true",
                   help="Sweep-scan mode instead of single frequency")
    
    p.add_argument("-i", "--interval", type=float, default="1",
                   help="Seconds between measurements (default 1 sec)")
    p.add_argument("-g", "--gain", type=str, default="auto",
                   help="SDR Gain (default is 'auto' for AGC)")
    p.add_argument("-r", "--rate", type=float, default="1.25",
                   help="Sample rate in MHz (default 1.25 MHZ)")
    p.add_argument("-n", "--samples", type=int, default="65536",
                   help="Number of samples (default 65536)")
    
    args = p.parse_args()

    start_freq = end_freq = step = None
    first_tune = None
    mode = None
    
    vals = args.freqs

    if args.scan:
        mode = "scan"
        if len(vals) < 2:
            p.error("--scan requires START and STOP frequencies.")
        
        start_freq = vals[0] * 1e6
        end_freq = vals[1] * 1e6
        
        if len(vals) >= 3:
            step = vals[2] * 1e6
        else:
            step = 0.5 * 1e6
            
        first_tune = start_freq
        
        if start_freq >= end_freq:
             p.error("START frequency must be less than STOP frequency.")

    else:
        mode = "monitor"
        if len(vals) != 1:
            p.error("Monitor mode requires exactly one frequency argument.")
        
        freq_val = vals[0]
        first_tune = freq_val if freq_val > 1e6 else freq_val * 1e6

    return args, mode, start_freq, end_freq, step, first_tune

if __name__ == "__main__":
    args, mode, start_freq, end_freq, step, first_tune = parse_args()
    sample_rate = args.rate * 1e6

    try:
        finder = CarrierFinder(center_freq=first_tune, sample_rate=sample_rate, gain=args.gain)
    except Exception as e:
        error_msg = str(e)
        if "Resource busy" in error_msg or "LIBUSB_ERROR_BUSY" in error_msg:
            print("Error: The SDR device is busy. Please close other applications using it and try again.")
        else:
            print(f"Unexpected error opening SDR: {e}")
            raise
        sys.exit(1)

    try:
        if mode == "scan":
            finder.continuous_scan(start_freq, end_freq, step, args.interval, args.samples)
        else:
            finder.continuous_monitor(first_tune, args.interval, args.samples)
    except KeyboardInterrupt:
        print("\nStopped by user.")
    finally:
        finder.close()
